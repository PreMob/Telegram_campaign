# Copy to .env and replace every placeholder. Never commit the filled-in file.

# Mandatory for every environment
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tagp:tagp@localhost:5432/tagp
APP_SECRET_KEY=replace-with-a-long-random-string
PHONE_ENCRYPTION_KEY=replace-with-a-different-long-random-string
PHONE_HMAC_KEY=replace-with-a-third-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-12-or-more-characters

# Mandatory in production. Optional locally: without Redis, imports run in a background thread.
REDIS_URL=redis://localhost:6379/0

# Optional until you connect a real bot. Both are required before invite links can be created.
BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_USER_ID=

# Optional behavior
TASK_MODE=
SEED_DEMO=false
DATA_DIR=./data
DEFAULT_REGION=US
LOGIN_RATE_LIMIT=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional outreach providers. Leave blank to keep those channels unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMS_API_URL=
SMS_API_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
